[Unit]
Description=TuVPN News Bot — генерация постов для канала
After=network-online.target
# Если процесс упал и не смог уведомить сам — запасное уведомление
OnFailure=tuvpn-news-fail.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/tuvpn
ExecStart=/usr/bin/python3 /root/tuvpn/news_bot.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tuvpn-news
